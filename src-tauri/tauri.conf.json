{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dust Launcher",
  "version": "0.1.0",
  "identifier": "com.dexter.dustlauncher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dust Launcher",
        "width": 1080,
        "height": 700,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
